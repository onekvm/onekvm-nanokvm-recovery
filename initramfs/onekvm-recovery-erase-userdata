#!/bin/sh
set -eu

# Unbind USB MSC before touching userdata. Harmless if the gadget is down.
gadget=/sys/kernel/config/usb_gadget/onekvm-recovery
if [ -e "$gadget/UDC" ]; then
    printf '\n' >"$gadget/UDC" || true
    sleep 1
fi

[ -b /dev/mmcblk0p4 ] || {
    echo "userdata partition not found" >&2
    exit 1
}
[ "$(cat /sys/class/block/mmcblk0p4/partition 2>/dev/null)" = 4 ] || {
    echo "refusing to erase an unexpected userdata device" >&2
    exit 1
}
userdata_size=$(cat /sys/class/block/mmcblk0p4/size 2>/dev/null) || {
    echo "cannot read userdata partition size" >&2
    exit 1
}
[ "$userdata_size" -ge 65536 ] || {
    echo "refusing to erase an undersized userdata partition" >&2
    exit 1
}

if grep -q ' /run/onekvm-recovery-data ' /proc/mounts; then
    umount /run/onekvm-recovery-data || {
        echo "cannot unmount userdata" >&2
        exit 1
    }
fi

mkfs.ext4 -F -L userdata \
    -U 4f4b564d-0000-4000-8000-000000000004 \
    -m 0 -J size=16 \
    -O ^orphan_file,^metadata_csum_seed \
    -E lazy_itable_init=1,lazy_journal_init=1 \
    /dev/mmcblk0p4 >/dev/null
sync

boot=/run/onekvm-recovery-boot
mkdir -p "$boot"
mount -t vfat -o rw /dev/mmcblk0p1 "$boot" || {
    echo "cannot mount the SD boot partition" >&2
    exit 1
}
rm -f "$boot/onekvm-factory-reset" "$boot/rec"
sync
umount "$boot" || {
    echo "cannot unmount the SD boot partition" >&2
    exit 1
}
rmdir "$boot" 2>/dev/null || true
echo "userdata erased"
