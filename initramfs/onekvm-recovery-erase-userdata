#!/bin/sh
set -eu
. /usr/lib/onekvm/storage-layout.sh
onekvm_storage_select && onekvm_storage_validate || { echo "invalid boot medium" >&2; exit 1; }

# Unbind USB MSC before touching userdata. Harmless if the gadget is down.
gadget=/sys/kernel/config/usb_gadget/onekvm-recovery
if [ -n "$(cat "$gadget/UDC" 2>/dev/null || true)" ]; then
    printf '\n' >"$gadget/UDC"
    sleep 1
fi

[ -b "$userdata" ] || {
    echo "userdata partition not found" >&2
    exit 1
}
[ "$(cat /sys/class/block/${disk_name}p4/partition 2>/dev/null)" = 4 ] || {
    echo "refusing to erase an unexpected userdata device" >&2
    exit 1
}
userdata_size=$(cat /sys/class/block/${disk_name}p4/size 2>/dev/null) || {
    echo "cannot read userdata partition size" >&2
    exit 1
}
[ "$userdata_size" -ge 65536 ] || {
    echo "refusing to erase an undersized userdata partition" >&2
    exit 1
}

if grep -q ' /run/onekvm-recovery-data ' /proc/mounts; then
    umount /run/onekvm-recovery-data || {
        echo "cannot unmount userdata" >&2
        exit 1
    }
fi

# Factory reset must not leave a previous static IP or MAC in the boot snapshot.
boot=/run/onekvm-recovery-network-reset
mkdir -p "$boot"
mount -t vfat -o rw "$loader" "$boot" || { echo "cannot clear Recovery network" >&2; exit 1; }
rm -f "$boot/recovery-network.json" "$boot/recovery-network.json.bak" "$boot/recovery-network.json.tmp" "$boot/.recovery-network.lock"
sync
umount "$boot" || { echo "cannot unmount boot partition" >&2; exit 1; }
rmdir "$boot" 2>/dev/null || true

# Same partition and size. Factory reset is the only path that replaces
# an existing filesystem, and the replacement is f2fs. Boot still mounts
# ext4 when this script has not run.
mkfs.f2fs -f -l userdata \
    -U "$userdata_uuid" \
    "$userdata" >/dev/null
sync
echo "userdata erased"
