#!/bin/sh
set -eu
# Prefer the complete offline tools over minimal initramfs BusyBox applets.
export PATH=/usr/libexec/onekvm-recovery:$PATH

onekvm_read_le32() {
    set -- $(od -An -tu1 -j "$2" -N4 "$1")
    [ $# -eq 4 ] || return 1
    echo $(( $1 + $2 * 256 + $3 * 65536 + $4 * 16777216 ))
}
onekvm_read_le16() {
    set -- $(od -An -tu1 -j "$2" -N2 "$1")
    [ $# -eq 2 ] || return 1
    echo $(( $1 + $2 * 256 ))
}
onekvm_read_le64() {
    set -- $(od -An -tu1 -j "$2" -N8 "$1")
    [ $# -eq 8 ] || return 1
    echo $(( $1 + $2 * 256 + $3 * 65536 + $4 * 16777216 \
        + $5 * 4294967296 + $6 * 1099511627776 \
        + $7 * 281474976710656 + $8 * 72057594037927936 ))
}
onekvm_read_hex() {
    od -An -tx1 -j "$2" -N"$3" "$1" | tr -d ' \n'
}
onekvm_hash() {
    "${ONEKVM_RECOVERY_SHA256:-/usr/sbin/onekvm-recovery-sha256}" "$@"
}
onekvm_validate_image_metadata() {
    image=$1
    expected_media=$2
    size=$(stat -c %s "$image")
    trailer_size=512
    metadata_size=480
    hash_size=32
    [ "$size" -ge "$trailer_size" ] || {
        echo 'image has no OneKVM metadata trailer' >&2; return 1;
    }
    trailer=$((size - trailer_size))
    [ "$(onekvm_read_hex "$image" "$trailer" 16)" = \
        4f4e454b564d2d494d472d4d45544100 ] || {
        echo 'image metadata magic is missing' >&2; return 1;
    }
    [ "$(onekvm_read_le16 "$image" $((trailer + 16)))" = 1 ] || {
        echo 'unsupported image metadata version' >&2; return 1;
    }
    [ "$(onekvm_read_le16 "$image" $((trailer + 18)))" = "$metadata_size" ] || {
        echo 'invalid image metadata length' >&2; return 1;
    }
    case "$expected_media" in
        nanokvm) expected_profile=1; expected_media_id=1 ;;
        pro-sd) expected_profile=2; expected_media_id=1 ;;
        pro-emmc) expected_profile=3; expected_media_id=2 ;;
        *) echo 'unknown target storage media' >&2; return 1 ;;
    esac
    [ "$(od -An -tu1 -j $((trailer + 20)) -N1 "$image" | tr -d ' \n')" = \
        "$expected_profile" ] || {
        echo 'image profile does not match target device' >&2; return 1;
    }
    [ "$(od -An -tu1 -j $((trailer + 21)) -N1 "$image" | tr -d ' \n')" = \
        "$expected_media_id" ] || {
        echo 'image storage type does not match target device' >&2; return 1;
    }
    payload_size=$(onekvm_read_le64 "$image" $((trailer + 24)))
    [ "$payload_size" = "$trailer" ] || {
        echo 'image metadata payload length is invalid' >&2; return 1;
    }
    expected_payload=$(onekvm_read_hex "$image" $((trailer + 36)) 32)
    actual_payload=$(onekvm_hash --bytes "$payload_size" "$image")
    [ "$actual_payload" = "$expected_payload" ] || {
        echo 'image payload hash mismatch' >&2; return 1;
    }
    expected_image=$(onekvm_read_hex "$image" $((size - hash_size)) "$hash_size")
    actual_image=$(onekvm_hash --bytes $((size - hash_size)) "$image")
    [ "$actual_image" = "$expected_image" ] || {
        echo 'image metadata/hash trailer mismatch' >&2; return 1;
    }
}
onekvm_detect_bundle() {
    magic=$(od -An -tx1 -N4 "$1" | tr -d ' \n')
    if [ "$magic" = 68737173 ]; then echo fwup; return; fi
    sig=$(od -An -tx1 -j510 -N2 "$1" | tr -d ' \n')
    id=$(od -An -tx1 -j440 -N4 "$1" | tr -d ' \n')
    if [ "$sig" = 55aa ]; then
        case "$id" in 4d564b4f|50564b4f) echo image; return ;; esac
    fi
    # Pro eMMC is an offset image, without an MBR in the vendor SPL prefix.
    if [ "$(stat -c %s "$1")" -ge 512 ] &&
       [ "$(od -An -tu1 -j $(( $(stat -c %s "$1") - 512 + 20 )) -N1 "$1" | tr -d ' \n')" = 3 ]; then
        echo emmc-image; return
    fi
    if [ "$(stat -c %s "$1")" -gt 291242032 ]; then
        magic=$(od -An -tx1 -j291241984 -N4 "$1" | tr -d ' \n')
        if [ "$magic" = 68737173 ]; then echo emmc-image; return; fi
    fi
    echo 'firmware is not a supported OneKVM bundle or image' >&2
    return 1
}
progress_write() {
    printf '%s\n' "$1" >"$progress.tmp"
    mv -f "$progress.tmp" "$progress"
}
cleanup() {
    result=$?
    trap - EXIT
    [ "$boot_mounted" = 0 ] || umount "$boot" || true
    [ "$img_mounted" = 0 ] || umount "$img_fat" || true
    [ "$bundle_mounted" = 0 ] || umount "$bundle_mount" || true
    [ "$result" = 0 ] || progress_write '{"phase":"error","message":"firmware install failed"}'
    exit "$result"
}
# Bounded, sector-rounded copies. Never copy trailing partitions from an image.
write_root_dd() {
    source=$1; skip_blocks=$2; dest=$3; total=$4
    count=$(((total + 511) / 512))
    [ "$total" -gt 0 ] && [ "$((count * 512))" -le "$root_slot_bytes" ] || return 1
    [ "$(stat -c %s "$source")" -ge "$((skip_blocks * 512 + total))" ] || return 1
    [ "$(blockdev --getsize64 "$dest")" -ge "$((count * 512))" ] || return 1
    dd if="$source" skip="$skip_blocks" count="$count" of="$dest" bs=512 conv=notrunc,fsync &
    ddpid=$!
    while kill -0 "$ddpid" 2>/dev/null; do
        written=$(sed -n 's/^write_bytes:[[:space:]]*//p' "/proc/$ddpid/io" 2>/dev/null || true)
        written=${written:-0}
        progress_write "{\"phase\":\"write-rootfs\",\"received\":$written,\"total\":$total}"
        sleep 1
    done
    wait "$ddpid" || return 1
    sync
}
verify_written() {
    written=$(/usr/sbin/onekvm-recovery-sha256 --bytes "$total" "$root_device")
    [ "$written" = "$expected" ] || { echo 'written rootfs hash mismatch' >&2; exit 1; }
}
copy_boot_file() {
    [ -s "$1" ]
    # Retain in-place writes for legacy Cube cards whose loader is only 32 MiB.
    # New images have enough room for a verified temporary replacement.
    if [ "$storage_media" = nanokvm ] && [ "$loader_size" = 65536 ]; then
        cp "$1" "$boot/$2"
        sync
        cmp -s "$1" "$boot/$2"
        return
    fi
    cp "$1" "$boot/.$2.new"
    sync
    cmp -s "$1" "$boot/.$2.new"
    mv -f "$boot/.$2.new" "$boot/$2"
    sync
}
# Only the target slot's payload is replaced. Shared Recovery is updated last.
install_boot() {
    mount -t vfat -o rw "$loader" "$boot"
    boot_mounted=1
    if [ "$storage_media" = nanokvm ]; then
        if [ "$kind" = fwup ]; then
            fit=$work/onekvm-nanokvm-boot-$lower-onekvm-nanokvm.itb
            build=$work/onekvm-nanokvm-build-id
            recovery=$work/onekvm-recovery.zip
        else
            fit=$img_fat/boot.sd; [ "$target" = A ] || fit=$img_fat/boot-b.itb
            build=$img_fat/build-id-$lower
            recovery=$img_fat/recovery.zip
        fi
        bootfile=boot.sd; [ "$target" = A ] || bootfile=boot-b.itb
        copy_boot_file "$fit" "$bootfile"
        copy_boot_file "$build" "build-id-$lower"
        copy_boot_file "$recovery" recovery.zip
        ONEKVM_BOOT_DIR=$boot "$storage_backend" set-state "$target" good
    else
        # The signed bundle hook and normal RAUC share this hardware adapter.
        if [ "$kind" != fwup ]; then
            mkdir -p "$extract"
            cp "$img_fat/Image-a" "$extract/pro-sd-Image"
            cp "$img_fat/ax630c-a.dtb" "$extract/pro-sd.dtb"
            cp "$img_fat/initramfs-a.uimg" "$extract/pro-sd-initramfs.uimg"
            cp "$img_fat/build-id-$lower" "$extract/pro-sd-build-id"
            for slot in a b; do cp "$img_fat/boot-$slot.scr" "$extract/pro-${storage_media#pro-}-boot-$slot.scr"; done
            cp "$img_fat/recovery.zip" "$extract/onekvm-recovery.zip"
            work=$extract
        fi
        RAUC_SLOT_CLASS=rootfs RAUC_SLOT_NAME=$slot_name RAUC_BUNDLE_MOUNT_POINT=$work \
            ONEKVM_BOOT_DIR=$boot /usr/libexec/onekvm/pro-bundle-hook slot-post-install
    fi
    ONEKVM_BOOT_DIR=$boot "$storage_backend" set-primary "$target"
    rm -f "$boot/boot_retry_time.txt"
    sync
    umount "$boot"
    boot_mounted=0
}
mark_target_bad() {
    mount -t vfat -o rw "$loader" "$boot"
    boot_mounted=1
    ONEKVM_BOOT_DIR=$boot "$storage_backend" set-state "$target" bad
    sync
    umount "$boot"
    boot_mounted=0
}
install_fwup() {
    progress_write '{"phase":"verify"}'
    # Keep the verified bundle compressed: Cube cannot hold both an upload
    # and a full extracted copy in RAM. RAUC checks CMS, then dm-verity
    # authenticates every read from this read-only squashfs mount.
    rm -rf "$extract"
    rauc -C keyring:path=/usr/lib/rauc/ca.cert.pem \
        -C keyring:use-bundle-signing-time=true --mount="$fwroot/verified" mount "$bundle"
    bundle_mounted=1
    work=$bundle_mount
    manifest=$work/manifest.raucm
    compatible=$(sed -n 's/^compatible=//p' "$manifest")
    [ "$compatible" = "$storage_compatible" ] || { echo 'bundle targets another machine' >&2; exit 1; }
    root_name=$(awk -F= '/^\[image.rootfs\]/{inside=1;next} /^\[/{inside=0} inside && $1=="filename"{print $2}' "$manifest")
    case "$root_name" in ''|*/*|*..*) exit 1 ;; esac
    rootfs=$work/$root_name
    total=$(stat -c %s "$rootfs")
    expected=$(/usr/sbin/onekvm-recovery-sha256 "$rootfs")
    # Read all boot files through verity before marking the target bad.
    # Hash output is discarded; the signed verity root authenticates them.
    for payload in "$work"/*; do
        [ "$payload" = "$rootfs" ] && continue
        [ -f "$payload" ] && /usr/sbin/onekvm-recovery-sha256 "$payload" >/dev/null
    done
    progress_write '{"phase":"write-rootfs"}'
    mark_target_bad
    write_root_dd "$rootfs" 0 "$root_device" "$total"
    verify_written
    progress_write '{"phase":"write-boot"}'
    install_boot
}
install_image() {
    progress_write '{"phase":"verify"}'
    onekvm_validate_image_metadata "$bundle" "$storage_media"
    if [ "$kind" = emmc-image ]; then
        [ "$storage_media" = pro-emmc ] || { echo 'eMMC image on another medium' >&2; exit 1; }
        boot_lba=306688; boot_sectors=262144; root_lba=568832; root_sectors=1048576
    else
        id=$(od -An -tx1 -j440 -N4 "$bundle" | tr -d ' \n')
        case "$storage_media:$id" in nanokvm:4d564b4f|pro-sd:50564b4f) ;; *) echo 'image targets another medium' >&2; exit 1 ;; esac
        boot_lba=$(onekvm_read_le32 "$bundle" 454)
        boot_sectors=$(onekvm_read_le32 "$bundle" 458)
        root_lba=$(onekvm_read_le32 "$bundle" 470)
        root_sectors=$(onekvm_read_le32 "$bundle" 474)
    fi
    case "$storage_media" in
        nanokvm) expected_geometry=1:262144:264192 ;;
        pro-sd) expected_geometry=2048:262144:264192 ;;
        pro-emmc) expected_geometry=306688:262144:568832 ;;
        *) exit 1 ;;
    esac
    [ "$boot_lba:$boot_sectors:$root_lba" = "$expected_geometry" ]
    root_offset=$((root_lba * 512))
    magic=$(od -An -tx1 -j "$root_offset" -N4 "$bundle" | tr -d ' \n')
    [ "$magic" = 68737173 ]
    [ "$(onekvm_read_le32 "$bundle" $((root_offset + 44)))" = 0 ]
    total=$(onekvm_read_le32 "$bundle" $((root_offset + 40)))
    [ "$total" -ge 65536 ] && [ "$total" -le "$((root_sectors * 512))" ]
    expected=$(/usr/sbin/onekvm-recovery-sha256 --skip "$root_offset" --bytes "$total" "$bundle")
    mount -t vfat -o "loop,ro,offset=$((boot_lba * 512)),sizelimit=$((boot_sectors * 512))" "$bundle" "$img_fat"
    img_mounted=1
    if [ "$storage_media" = nanokvm ]; then
        [ -s "$img_fat/boot.sd" ] && [ -s "$img_fat/boot-b.itb" ] && [ -s "$img_fat/build-id-a" ] && [ -s "$img_fat/recovery.zip" ]
    elif [ "$storage_media" = pro-emmc ]; then
        [ "$(cat "$img_fat/image-format")" = "$storage_media" ]
        for name in Image-a ax630c-a.dtb initramfs-a.uimg boot-a.scr boot-b.scr build-id-a recovery.zip; do [ -s "$img_fat/$name" ]; done
    else
        [ "$(cat "$img_fat/image-format")" = "$storage_media" ]
        for name in Image-a ax630c-a.dtb initramfs-a.uimg boot-a.scr boot-b.scr build-id-a recovery.zip; do [ -s "$img_fat/$name" ]; done
    fi
    mark_target_bad
    write_root_dd "$bundle" "$root_lba" "$root_device" "$total"
    verify_written
    install_boot
}

# Host tests can source the pure detection/copy helpers without touching disks.
[ "${ONEKVM_RECOVERY_LIBRARY_ONLY:-0}" != 1 ] || return 0
bundle=${1:-}
if [ "$bundle" = --detect ]; then onekvm_detect_bundle "${2:?file required}"; exit; fi
[ -n "$bundle" ] && [ -s "$bundle" ] || { echo 'usage: onekvm-recovery-install-fwup FILE' >&2; exit 2; }
kind=$(onekvm_detect_bundle "$bundle")
. /usr/lib/onekvm/storage-layout.sh
onekvm_storage_links || { echo 'invalid boot medium' >&2; exit 1; }
if [ "$storage_media" = nanokvm ]; then storage_backend=/usr/libexec/onekvm/nanokvm-bootchooser
else storage_backend=/usr/libexec/onekvm/pro-sd-bootchooser; fi
case "$storage_slot" in A) target=B; lower=b; root_device=$root_b; slot_name=rootfs.1 ;; B) target=A; lower=a; root_device=$root_a; slot_name=rootfs.0 ;; *) exit 1 ;; esac
# Local disk writes and USB whole-disk writes must never overlap.
gadget=/sys/kernel/config/usb_gadget/onekvm-recovery
if [ -n "$(cat "$gadget/UDC" 2>/dev/null || true)" ]; then
    printf '\n' >"$gadget/UDC"
    sleep 1
fi
# reset-user may have mounted userdata earlier in this recovery session.
if grep -q ' /run/onekvm-recovery-data ' /proc/mounts; then umount /run/onekvm-recovery-data; fi
progress=${ONEKVM_RECOVERY_PROGRESS:-/run/onekvm-recovery-progress}
fwroot=/run/onekvm-firmware
extract=$fwroot/fw-extract
img_fat=$fwroot/img-boot
bundle_mount=$fwroot/verified/bundle
boot=/run/onekvm-recovery-boot
boot_mounted=0; img_mounted=0; bundle_mounted=0
mkdir -p "$boot" "$img_fat"
trap cleanup EXIT
if [ "$kind" = fwup ]; then install_fwup; else install_image; fi
progress_write '{"phase":"done"}'
echo "installed firmware to slot $target"
